node_modules
dist
*.local

# Incremental build state, regenerated by `tsc -b`. Committing it means a
# fresh clone starts from another machine's cache and can skip work it needs
# to do, so builds succeed locally and fail on CI (or vice versa).
tsconfig.tsbuildinfo

# The repo-root .gitignore has a broad `data/` rule to keep personal health
# data out of the repository. That rule also matches src/data/, which holds
# GENERATED build inputs -- the anatomy geometry, the rig manifests, and the
# bundled example programs. They are imported directly by the TypeScript, so
# a fresh clone without them fails at `tsc -b` before Vite ever runs.
#
# Re-include them explicitly. They contain no personal data: they are
# produced by scripts/extract-anatomy.mjs and scripts/inspect-glb.mjs from
# files already in the repository.
# Named individually rather than with a wildcard: subject.json is generated
# by scripts/set-body-parameters.mjs and holds a real person's mass, stature
# and sex. It is written INTO this directory but never imported by the build,
# so a wildcard would publish personal data the root rule exists to protect.
!src/data/
!src/data/anatomy.json
!src/data/programs.json
!src/data/rigs.json
# ...and re-ignore the one that is personal. The `!src/data/` line above has
# to un-ignore the directory before any file inside it can be re-included, so
# this exclusion must come after it.
src/data/subject.json

# The repo-root .gitignore has a broad `*.png` rule. These three are part of
# the anatomy template, not output: the SVG regions are painted over them.
!public/anatomy/images/modela.png
!public/anatomy/images/modelb.png
!public/anatomy/images/hover.png
